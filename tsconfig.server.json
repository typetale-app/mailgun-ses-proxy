{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "lib": ["es2019", "dom", "dom.iterable", "esnext"],
        "target": "es2019",
        "module": "commonjs",
        "moduleResolution": "node",
        "isolatedModules": false,
        "noEmit": false
    },
    "include": ["server.ts", "lib/**/*.*", "service/**/*.ts"],
    "exclude": ["node_modules", "tests", "**/*.test.ts", "**/*.spec.ts"]
}
