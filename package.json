{
    "name": "mailgun-to-ses-proxy",
    "version": "2.3.2",
    "private": true,
    "scripts": {
        "dev": "nodemon",
        "next:build": "next build --webpack",
        "docker:build": "docker build -t mailgun-to-ses-proxy .",
        "build": "prisma generate && next build --webpack && tsc --noEmit",
        "start": "NODE_ENV=production prisma migrate deploy && tsx --env-file-if-exists=.env server.ts",
        "start:bun": "NODE_ENV=production prisma migrate deploy && bun server.ts",
        "lint": "next lint",
        "db:migrate:dev": "prisma migrate dev",
        "db:migrate": "prisma migrate deploy",
        "db:generate": "prisma generate",
        "test": "runPrismaTests=false vitest",
        "test:prisma": "vitest --run tests/prisma-orm.test.ts",
        "test:run": "runPrismaTests=false vitest --run",
        "test:coverage": "vitest --coverage",
        "test:watch": "vitest --watch",
        "test:ui": "vitest --ui",
        "bump": "npm version patch && git push --tags"
    },
    "dependencies": {
        "@aws-sdk/client-sesv2": "^3.1054.0",
        "@aws-sdk/client-sqs": "^3.1054.0",
        "@prisma/adapter-mariadb": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@tailwindcss/postcss": "^4.3.0",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "lucide-react": "^1.16.0",
        "mariadb": "^3.5.2",
        "next": "^16.2.6",
        "pino": "^10.3.1",
        "prisma": "^7.8.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "sqs-consumer": "^15.0.2",
        "tailwind-merge": "^3.6.0",
        "tsx": "^4.22.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^24.12.4",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "tailwindcss": "^4.3.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.7"
    },
    "overrides": {
        "@hono/node-server": "^2.0.0",
        "postcss": "^8.5.15"
    }
}
